<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Monsoon</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body {
        font-family: 'Inter', sans-serif;
        background: #000;
        color: #fff;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      /* ---------- Navbar ---------- */
      .navbar {
        position: fixed;
        top: 18px; left: 0; right: 0;
        z-index: 50;
        display: flex; justify-content: center;
        padding: 0 20px;
        opacity: 0; transform: translateY(-16px);
        animation: navIn 0.6s ease-out forwards;
        animation-delay: 0.1s;
      }
      @keyframes navIn {
        to { opacity: 1; transform: translateY(0); }
      }
      .navbar-inner {
        display: flex; align-items: center; gap: 36px;
        padding: 11px 22px;
        border-radius: 999px;
        background: rgba(255,255,255,0.55);
        border: 1px solid rgba(255,255,255,0.65);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        box-shadow: 0 6px 24px rgba(0,0,0,0.12);
      }
      .navbar-brand {
        font-size: 17px; font-weight: 700;
        color: #1f1f1f;
        letter-spacing: -0.01em;
      }
      .navbar-links { display: flex; align-items: center; gap: 24px; }
      .navbar-link {
        font-size: 13px; font-weight: 500;
        color: rgba(40,40,40,0.72);
        text-decoration: none;
        white-space: nowrap;
        transition: color 0.2s ease;
      }
      .navbar-link:hover { color: #1f1f1f; }

      /* ---------- Hero ---------- */
      .hero {
        position: relative;
        width: 100%; height: 100vh;
        overflow: hidden;
      }

      /* Трансформированный контейнер гор — наклон */
      .hero-mountains {
        position: absolute; inset: 0; overflow: hidden;
        transform: skewX(-1.5deg) translateX(1.5%);
      }
      .hero-mountains img {
        position: absolute;
        object-fit: cover;
        filter: saturate(1.08) contrast(1.02) brightness(1.02);
      }
      .hero-mountains .m1 {
        inset: 0;
        width: 115%; height: 115%;
        object-position: center;
      }
      .hero-mountains .m2 {
        top: 12%; left: -10%;
        width: 85%; height: 90%;
        object-position: center 28%;
        filter: saturate(0.78) brightness(0.82) contrast(1.06);
      }
      .hero-mountains .m3 {
        bottom: 2%; right: -8%;
        width: 72%; height: 72%;
        object-position: center 55%;
        filter: saturate(0.55) brightness(0.72) contrast(1.08);
      }

      /* Оверлеи */
      .hero-overlay {
        position: absolute; inset: 0;
        background: rgba(0,0,0,0.12);
      }
      .hero-grad-v {
        position: absolute; inset: 0;
        background: linear-gradient(
          to bottom,
          rgba(0,0,0,0.15) 0%,
          transparent 22%,
          transparent 62%,
          rgba(0,0,0,0.22) 100%
        );
      }
      .hero-grad-h {
        position: absolute; inset: 0;
        background: linear-gradient(
          to right,
          rgba(0,0,0,0.08) 0%,
          transparent 16%,
          transparent 84%,
          rgba(0,0,0,0.08) 100%
        );
      }
      .hero-radial {
        position: absolute;
        top: -14%; left: 50%;
        transform: translateX(-50%);
        width: 1000px; height: 720px;
        background: radial-gradient(
          ellipse at 50% 30%,
          rgba(55,48,163,0.04) 0%,
          transparent 68%
        );
        pointer-events: none;
      }

      /* Контент */
      .hero-content {
        position: relative; z-index: 10;
        height: 100%;
        display: flex; flex-direction: column;
        align-items: center; text-align: center;
        padding: 15vh 24px 0;
      }

      .eyebrow {
        display: inline-flex; align-items: center;
        padding: 5px 13px;
        border-radius: 999px;
        background: rgba(255,255,255,0.35);
        border: 1px solid rgba(255,255,255,0.5);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        font-size: 11px; font-weight: 500;
        color: rgba(40,40,40,0.78);
        margin-bottom: 20px;
        opacity: 0; transform: translateY(10px);
        animation: fadeUp 0.7s ease-out 0.2s forwards;
      }
      @keyframes fadeUp {
        to { opacity: 1; transform: translateY(0); }
      }

      h1 {
        margin: 0;
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: clamp(1.9rem, 4.4vw, 3.1rem);
        line-height: 1.08;
        letter-spacing: -0.025em;
        color: #1f1f1f;
        opacity: 0; transform: translateY(22px);
        animation: fadeUp 0.8s ease-out 0.32s forwards;
      }

      .subtext {
        margin: 16px 0 0;
        max-width: 460px;
        font-size: 14px; line-height: 1.6;
        color: rgba(40,40,40,0.7);
        font-weight: 500;
        opacity: 0; transform: translateY(16px);
        animation: fadeUp 0.8s ease-out 0.48s forwards;
      }

      .hero-buttons {
        display: flex; align-items: center; gap: 13px;
        margin-top: 28px;
        opacity: 0; transform: translateY(16px);
        animation: fadeUp 0.8s ease-out 0.62s forwards;
      }
      .btn {
        padding: 12px 24px;
        border-radius: 9px;
        font-size: 14px; font-weight: 600;
        font-family: 'Inter', sans-serif;
        text-decoration: none;
        transition: transform 0.15s ease, background 0.2s ease;
        display: inline-block;
      }
      .btn:active { transform: scale(0.97); }
      .btn-primary {
        color: #fff;
        background: #1a1a1a;
        box-shadow: 0 6px 20px rgba(0,0,0,0.22);
      }
      .btn-primary:hover { transform: scale(1.04); }
      .btn-ghost {
        color: #1f1f1f;
        background: rgba(255,255,255,0.65);
        border: 1px solid rgba(255,255,255,0.7);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
      }
      .btn-ghost:hover {
        transform: scale(1.04);
        background: rgba(255,255,255,0.85);
      }

      /* ---------- Sponsor strip ---------- */
      .sponsor-strip {
        position: absolute;
        bottom: 0; left: 0; right: 0;
        z-index: 10;
        padding: 20px 24px 30px;
        text-align: center;
        opacity: 0; transform: translateY(16px);
        animation: fadeUp 0.8s ease-out 0.8s forwards;
      }
      .sponsor-label {
        margin: 0 0 16px;
        font-size: 11px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.6);
        text-shadow: 0 1px 10px rgba(0,0,0,0.5);
      }
      .sponsor-names {
        display: flex;
        align-items: center; justify-content: center;
        gap: 44px;
        flex-wrap: wrap;
        max-width: 820px;
        margin: 0 auto;
      }
      .sponsor-name {
        font-size: 18px; font-weight: 700;
        letter-spacing: 0.02em;
        color: rgba(255,255,255,0.72);
        cursor: default;
        transition: color 0.25s ease;
        text-shadow: 0 1px 10px rgba(0,0,0,0.5);
      }
      .sponsor-name:hover { color: #fff; }
    </style>
  </head>
  <body>
    <!-- Frosted-glass pill navbar -->
    <nav class="navbar">
      <div class="navbar-inner">
        <span class="navbar-brand">Monsoon</span>
        <div class="navbar-links">
          <a class="navbar-link" href="#product">Product</a>
          <a class="navbar-link" href="#solutions">Solutions</a>
          <a class="navbar-link" href="#pricing">Pricing</a>
          <a class="navbar-link" href="#resources">Resources</a>
          <a class="navbar-link" href="#about">About</a>
          <a class="navbar-link" href="#contact">Contact</a>
        </div>
      </div>
    </nav>

    <!-- ГERO-секция -->
    <section class="hero">
      <!-- Горы с наклоном -->
      <div class="hero-mountains">
        <img class="m1" src="mountain1.jpg" alt="" />
        <img class="m2" src="mountain2.jpg" alt="" />
        <img class="m3" src="mountain3.jpg" alt="" />
      </div>

      <!-- Оверлеи -->
      <div class="hero-overlay"></div>
      <div class="hero-grad-v"></div>
      <div class="hero-grad-h"></div>
      <div class="hero-radial"></div>

      <!-- Контент -->
      <div class="hero-content">
        <span class="eyebrow">For teams that never stop</span>
        <h1>Weather any storm</h1>
        <p class="subtext">
          Resilient operations software that keeps your business running
          through outages, spikes, and everything in between.
        </p>
        <div class="hero-buttons">
          <a class="btn btn-primary" href="#start">Get Started</a>
          <a class="btn btn-ghost" href="#plans">See Plans</a>
        </div>
      </div>

      <!-- Спонсорская полоска -->
      <div class="sponsor-strip">
        <p class="sponsor-label">Trusted by teams at</p>
        <div class="sponsor-names">
          <span class="sponsor-name">Northwind</span>
          <span class="sponsor-name">Vantage</span>
          <span class="sponsor-name">Kestrel</span>
          <span class="sponsor-name">Meridian</span>
          <span class="sponsor-name">Sonaris</span>
        </div>
      </div>
    </section>
  </body>
</html>
